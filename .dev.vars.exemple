ACCESS_DESACTIVE=1
# Clé API Apify : Settings → API & Integrations sur console.apify.com
APIFY_TOKEN=
# Clé INSEE facultative (gratuite sur portail-api.insee.fr) pour les nouvelles entreprises du registre Sirene.
INSEE_API_KEY=
# Clé API Anthropic, pour que Claude juge chaque site : console.anthropic.com → API Keys.
# Sans clé, l'analyse se fait avec les règles seules.
ANTHROPIC_API_KEY=
# Ou une clé OpenRouter (openrouter.ai → Keys) : elle passe avant la clé Anthropic.
OPENROUTER_API_KEY=
# Modèle utilisé. Par défaut Haiku : claude-haiku-5-5, ou anthropic/claude-haiku-5.5 avec OpenRouter.
# Opus (claude-opus-5-5) juge un peu mieux mais coûte environ 40 fois plus cher.
CLAUDE_MODELE=
